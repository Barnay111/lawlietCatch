{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "src/react.tsx"
  ]
}
